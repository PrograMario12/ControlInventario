# Copia este archivo como .env y completa los valores.
# El archivo .env contiene contraseñas: está en .gitignore y NUNCA debe subirse a git.
# Si una contraseña tiene caracteres especiales (@ : / ? #), escríbela codificada en la URL (ej. @ -> %40).

# ---------------------------------------------------------------------------
# Base de datos que usa la app
# ---------------------------------------------------------------------------
# Opción A: PostgreSQL local con Docker (usa la misma contraseña que POSTGRES_PASSWORD).
DATABASE_URL=postgresql+psycopg://inventario:TU_CONTRASENA@localhost:5432/inventario

# Opción B: Neon u otro PostgreSQL en la nube. Pega la URL tal como te la dan
# (con `neon link` se escribe sola en este archivo).
# DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Contenedor local de PostgreSQL (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=inventario
POSTGRES_PASSWORD=TU_CONTRASENA
POSTGRES_DB=inventario

# ---------------------------------------------------------------------------
# Pruebas automáticas (pytest)
# ---------------------------------------------------------------------------
# Las pruebas BORRAN todas las tablas de esta base. Por seguridad su nombre debe contener "test".
# Nunca pongas aquí tu base real.
TEST_DATABASE_URL=postgresql+psycopg://inventario:TU_CONTRASENA@localhost:5432/inventario_test
